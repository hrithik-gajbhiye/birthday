  opacity: 0;
  transform: scale(1.4);
  filter: blur(10px);
  pointer-events: none;
}

/* ZOOM-OUT (Outgoing backward: zooms toward user) */
.page.zoom-out-backward {
  opacity: 0;
  transform: scale(1.4);
  filter: blur(8px);
  pointer-events: none;
  z-index: 5;
}

/* ZOOM-IN (Incoming backward: starts small, zooms up into normal scale) */
