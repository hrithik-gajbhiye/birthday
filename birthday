  /* Fonts */
  --font-h: 'Space Grotesk', sans-serif;
  --font-b: 'Outfit', sans-serif;
  --font-hw: 'Caveat', cursive;

  /* Sizing */
  --radius-card: 26px;
  --radius-pill: 999px;
  --radius-sm: 14px;

  /* Shadows */
  --shadow-card: 0 10px 36px rgba(240, 37, 154, 0.18), 0 2px 10px rgba(0, 0, 0, 0.05);
  --shadow-card-hover: 0 26px 65px rgba(240, 37, 154, 0.35), 0 8px 24px rgba(0, 0, 0, 0.09);
  --shadow-btn: 0 6px 24px rgba(240, 37, 154, 0.45);
  --shadow-btn-hover: 0 12px 38px rgba(240, 37, 154, 0.68);

  /* Easing */
  --ease: cubic-bezier(0.2, 0.9, 0.25, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ────────────────── RESET ────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { overflow: hidden; height: 100%; }

body {
  font-family: var(--font-b);
  background: var(--bg-main);
  color: var(--text-dark);
  height: 100%;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
  position: relative;
}

/* ────────────────── CANVASES ────────────────── */
#particle-canvas {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.85;
}

#fireworks-canvas {
  position: fixed;
  inset: 0;
  z-index: 5;
  pointer-events: none;
  background: transparent !important;
}

/* ────────────────── PAGE STACK (ZOOM-IN / ZOOM-OUT) ────────────────── */
.page-container {
  position: fixed;
  inset: 0;
  z-index: 2;
  perspective: 1200px;
}

/* Base page state */
.page {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: var(--bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transform: scale(0.75);
  transition: opacity 0.55s var(--ease), transform 0.6s var(--ease), filter 0.55s var(--ease);
  overflow-y: auto;
  overflow-x: hidden;
  transform-origin: center center;
}

/* GLASSMORPHISM BACKGROUND OVERLAY - applies to ALL pages */
.glass-page-bg {
  position: absolute;
  inset: 0;
  background: rgba(255, 240, 248, 0.35);
  backdrop-filter: blur(8px) saturate(140%);
  -webkit-backdrop-filter: blur(8px) saturate(140%);
  z-index: 2;
  pointer-events: none;
}

/* Active visible page */
.page.active {
  opacity: 1;
  pointer-events: all;
  transform: scale(1);
  filter: blur(0px);
  z-index: 10;
}

/* ZOOM-OUT (Outgoing forward) */
.page.zoom-out-forward {
  opacity: 0;
  transform: scale(0.65);
  filter: blur(8px);
  pointer-events: none;
  z-index: 5;
}

/* ZOOM-IN (Incoming forward: starts big, zooms into normal scale) */
