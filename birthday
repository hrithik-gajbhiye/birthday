}

.floating-emoji {
  position: absolute;
  pointer-events: none !important;
  user-select: none !important;
  font-size: clamp(1.2rem, 2.2vw, 1.8rem);
  opacity: var(--base-opacity, 0.22);
  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.35));
  animation: floatEmojiDrift var(--dur, 14s) ease-in-out var(--delay, 0s) infinite alternate;
  will-change: transform, opacity;
  line-height: 1;
}

@keyframes floatEmojiDrift {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(0.92);
    opacity: var(--base-opacity, 0.2);
  }
  50% {
    transform: translate(var(--tx, 20px), var(--ty, -35px)) rotate(var(--rot, 12deg)) scale(1.08);
    opacity: calc(var(--base-opacity, 0.2) * 1.35);
  }
  100% {
    transform: translate(var(--tx2, -18px), var(--ty2, -65px)) rotate(calc(var(--rot, 12deg) * -1)) scale(0.95);
    opacity: calc(var(--base-opacity, 0.2) * 0.85);
  }
}

/* === FLOATING BG BALLOONS === */
.bg-balloon {
  position: absolute;
  bottom: -10%;
  font-size: 2.5rem;
  opacity: 0.4;
  animation: floatUp 12s linear infinite;
  pointer-events: none;
  z-index: 0;
  filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
}
.bg-balloon:nth-child(even) {
  animation-duration: 15s;
  font-size: 3.5rem;
  filter: blur(1px);
}
.bg-balloon:nth-child(3n) {
  animation-duration: 18s;
  font-size: 1.8rem;
  opacity: 0.6;
}
@keyframes floatUp {
  0% { transform: translateY(0) rotate(-10deg) translateX(0); opacity: 0; }
  10% { opacity: 0.5; }
  90% { opacity: 0.5; }
  100% { transform: translateY(-120vh) rotate(15deg) translateX(50px); opacity: 0; }
}

