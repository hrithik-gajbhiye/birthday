  animation: vid-play-btn-subtle-glow 1.5s infinite ease-in-out !important;
  outline: none;
}

@keyframes vid-play-btn-subtle-glow {
  0%, 100% {
    transform: scale(1);
    box-shadow: 
      0 0 12px rgba(240, 37, 154, 0.75),
      0 0 20px rgba(253, 230, 138, 0.4),
      inset 0 1px 2px rgba(255, 255, 255, 0.8);
