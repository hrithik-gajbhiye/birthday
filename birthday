}
@keyframes palm-sway { 0% { transform: rotate(0deg); } 100% { transform: rotate(6deg); } }

/* DANCER */
.disco-spotlight {
  position: absolute;
  top: -100px;
  width: 280px;
  height: 600px;
  background: radial-gradient(ellipse at top, rgba(240, 37, 154, 0.3), rgba(192, 132, 252, 0.18), transparent 70%);
