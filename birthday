  --pink-soft: #fbb6d6;
  --rose-deep: #c2185b;
  --rose-red: #e91e63;
  --gold: #f59e0b;
  --gold-light: #fde68a;
  --violet-soft: #c084fc;
  --sky-blue: #38bdf8;
  --text-dark: #1e0a14;
