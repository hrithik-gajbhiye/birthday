.pm-label { font-size: 0.72rem; font-weight: 700; color: var(--rose-deep); text-align: center; }
.pm-file { font-size: 0.6rem; color: var(--pink-hot); font-family: monospace; }
.polaroid-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; }
.polaroid-caption { font-family: var(--font-hw); font-size: 1.25rem; font-weight: 700; color: #1e0a14; line-height: 1.1; }
.polaroid-stamp {
  font-family: var(--font-h); font-size: 0.62rem; font-weight: 800;
  color: var(--rose-red); background: #ffe4e6;
  border: 1px dashed var(--rose-red); padding: 2px 6px; border-radius: 4px;
  transform: rotate(-4deg); text-transform: uppercase;
