  animation: tutorial-badge-pulse 2s ease-in-out infinite;
}

@keyframes tutorial-badge-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); box-shadow: 0 8px 24px rgba(0,0,0,0.5), 0 0 25px rgba(255, 215, 0, 0.85); }
}

/* 🎀 RIBBON PULL TRACK & DRAGGABLE HANDLE */
.ribbon-pull-track {
  position: absolute;
  bottom: clamp(94px, 13.5vh, 120px);
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: clamp(130px, 20vh, 175px);
  z-index: 25;
  pointer-events: none;
}

.ribbon-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: clamp(24px, 4vw, 30px);
  height: var(--ribbon-h, 24px);
  background: linear-gradient(180deg, #ff2a85 0%, #ff7300 25%, #ffd700 50%, #00f2fe 75%, #9d4edd 100%);
  border-radius: 8px 8px 0 0;
  box-shadow: 0 0 18px rgba(255, 42, 133, 0.65), inset 0 0 10px rgba(255, 255, 255, 0.5);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ribbon-texture {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.2) 0,
    rgba(255, 255, 255, 0.2) 4px,
    transparent 4px,
    transparent 8px
  );
}

.ribbon-stars {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
  font-size: 0.65rem;
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 0 4px #ffd700;
}

.ribbon-tip-handle {
  position: absolute;
  bottom: var(--ribbon-h, 24px);
  left: 50%;
  transform: translate(-50%, 50%);
  width: clamp(52px, 8vw, 64px);
  height: clamp(52px, 8vw, 64px);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: grab;
  pointer-events: auto;
  touch-action: none;
  z-index: 28;
  outline: none;
}

.ribbon-tip-handle:active,
.ribbon-tip-handle.is-dragging {
  cursor: grabbing;
}

.ribbon-tip-pulse {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: ribbon-tip-pulse 1.3s ease-in-out infinite alternate;
  filter: drop-shadow(0 0 12px rgba(255, 42, 133, 0.85));
  transition: transform 0.15s ease;
}

@keyframes ribbon-tip-pulse {
  0% {
    transform: scale(1);
    filter: drop-shadow(0 0 10px rgba(255, 42, 133, 0.75));
  }
  100% {
    transform: scale(1.22) translateY(-3px);
    filter: drop-shadow(0 0 24px rgba(255, 215, 0, 0.95)) drop-shadow(0 0 12px rgba(255, 42, 133, 0.9));
  }
}

.ribbon-tip-icon {
  font-size: clamp(2rem, 5vw, 2.6rem);
  line-height: 1;
}

.ribbon-pull-arrow {
  font-size: 0.82rem;
  margin-top: -6px;
  animation: bounce-arrow 0.9s ease-in-out infinite alternate;
}

@keyframes bounce-arrow {
  0% { transform: translateY(0); }
  100% { transform: translateY(-5px); }
}

.ribbon-tip-aura {
  position: absolute;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.45) 0%, rgba(240, 37, 154, 0) 70%);
