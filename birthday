  background: linear-gradient(135deg, #ff1493 0%, #ff2a9d 45%, #f43f5e 100%) !important;
  color: #ffffff !important;
  border: 2px solid rgba(255, 255, 255, 0.95) !important;
  cursor: pointer;
  font-size: 1.15rem !important;
  display: flex;
  align-items: center;
  justify-content: center;
