  box-shadow: 0 20px 45px rgba(240, 37, 154, 0.35);
  z-index: 10;
}
.polaroid-photo { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; display: block; }
.polaroid-mock {
  width: 100%; aspect-ratio: 1;
