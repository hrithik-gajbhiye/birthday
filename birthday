}

@keyframes tutorial-grab-pull {
  0% {
    transform: translateY(0) scale(1);
    opacity: 0.9;
  }
  25% {
    transform: translateY(16px) scale(0.92);
    opacity: 1;
  }
  70% {
    transform: translateY(-55px) scale(0.92);
    opacity: 1;
  }
  85% {
    transform: translateY(-60px) scale(1);
    opacity: 0.7;
  }
  100% {
    transform: translateY(-60px) scale(1);
    opacity: 0;
  }
}

.tutorial-text-badge {
  background: rgba(18, 7, 34, 0.92);
  border: 1.5px solid rgba(255, 215, 0, 0.75);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(240, 37, 154, 0.6);
