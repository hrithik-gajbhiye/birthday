:root {
  /* Bright Pastel Pink Core - MORE PINK */
  --bg-main: #ffe0f0;
  --bg-page: radial-gradient(circle at 50% 20%, #fff5fa 0%, #ffe0f0 40%, #ffc1e3 75%, #ffaad4 100%);
