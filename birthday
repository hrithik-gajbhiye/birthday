}
@keyframes eq-pulse { 0% { height: 12px; } 100% { height: var(--h, 75px); } }

/* ═══ PAGE 8: SCRAPBOOK GALLERY ═══ */
.gallery-inner { justify-content: flex-start; padding-top: 20px; gap: 16px; overflow-y: auto; }
.polaroid-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 22px;
  width: 100%;
  max-width: 960px;
}
.polaroid-card {
  background: rgba(255,255,255,0.88);
  padding: 12px 12px 18px;
