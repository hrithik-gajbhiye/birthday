/* === LIGHTWEIGHT PAGE-RELATED FLOATING EMOJIS (PAGES 0–11) === */
.page-floating-emojis {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none !important;
  user-select: none !important;
