  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  user-select: none;
}

/* 👆 TUTORIAL OVERLAY */
.magic-hat-tutorial {
  position: absolute;
  bottom: clamp(140px, 20vh, 185px);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  z-index: 50;
  pointer-events: none;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.magic-hat-tutorial.hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateX(-50%) translateY(-15px);
}

.tutorial-hand-anim {
  font-size: clamp(2rem, 4.5vw, 2.5rem);
