}

/* 🎩 INTERACTIVE ZONE (HAT + RIBBON + CAKE + TUTORIAL) */
.magic-hat-interactive-zone {
  position: relative;
  width: min(340px, 90vw);
  height: clamp(230px, 35vh, 290px);
